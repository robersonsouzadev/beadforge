# ══════════════════════════════════════════════════════════════════════
# BeadForge Studio SaaS — Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════════════

# ── Banco de Dados (PostgreSQL) ──
# Em ambiente local / Docker Compose interno:
DATABASE_URL=postgres://beadforge:beadforge_secure_pass_2026@localhost:5432/beadforge_db
POSTGRES_USER=beadforge
POSTGRES_PASSWORD=beadforge_secure_pass_2026
POSTGRES_DB=beadforge_db

# ── Better Auth ──
# Gere uma chave segura executando: openssl rand -base64 32
BETTER_AUTH_SECRET=sua_chave_secreta_super_segura_aqui_gerada_com_openssl
BETTER_AUTH_URL=https://app.hamabeadsbrasil.com.br

# ── Provedores de Login Social (OAuth) ──
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub Developer Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Stripe (Pagamentos & Assinaturas Recorrentes) ──
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# IDs dos Preços criados no Stripe Dashboard (Produtos > Preços):
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_...

# ── URL Pública da Aplicação ──
NEXT_PUBLIC_APP_URL=https://app.hamabeadsbrasil.com.br

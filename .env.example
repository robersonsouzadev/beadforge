# ─────────────────────────────────────────────────────────────
# BeadForge Studio — Variáveis de Ambiente
# ─────────────────────────────────────────────────────────────

# URL Base da Aplicação
NEXT_PUBLIC_APP_URL="https://app.hamabeadsbrasil.com.br"
BETTER_AUTH_URL="https://app.hamabeadsbrasil.com.br"
BETTER_AUTH_SECRET="sua_chave_secreta_aqui"

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Stripe Secret Keys (Dashboard Stripe -> Desenvolvedores -> Chaves de API)
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─────────────────────────────────────────────────────────────
# IDs de Preços dos Produtos Stripe (Catálogo de Produtos)
# ─────────────────────────────────────────────────────────────

# 1. Creator Pro (R$ 19,90/mês e R$ 199,00/ano)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY="price_..."

# 2. Studio Ateliê (R$ 79,00/mês e R$ 790,00/ano)
NEXT_PUBLIC_STRIPE_PRICE_STUDIO_MONTHLY="price_..."
NEXT_PUBLIC_STRIPE_PRICE_STUDIO_YEARLY="price_..."

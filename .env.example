# ─────────────────────────────────────────────────────────────
# BeadForge Studio — Variáveis de Ambiente
# ─────────────────────────────────────────────────────────────

# URL Base da Aplicação
NEXT_PUBLIC_APP_URL="https://app.hamabeadsbrasil.com.br"
BETTER_AUTH_URL="https://app.hamabeadsbrasil.com.br"
BETTER_AUTH_SECRET="sua_chave_secreta_aqui"

# Google OAuth (Login com Google)
GOOGLE_CLIENT_ID="seu_client_id_google.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_client_secret_google"

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@host:5432/banco"

# Stripe Secret Keys (Dashboard Stripe -> Desenvolvedores -> Chaves de API)
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

